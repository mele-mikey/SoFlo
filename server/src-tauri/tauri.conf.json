{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SoFlo Server",
  "version": "1.0.0",
  "identifier": "edu.soflo.server",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm --prefix server run dev",
    "beforeBuildCommand": "npm --prefix server run build"
  },
  "app": {
    "windows": [{ "title": "SoFlo Server", "width": 1060, "height": 820, "minWidth": 760, "minHeight": 640, "resizable": true, "decorations": false, "transparent": false, "center": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": ["../../src-tauri/icons/32x32.png", "../../src-tauri/icons/128x128.png", "../../src-tauri/icons/128x128@2x.png", "../../src-tauri/icons/icon.ico"]
  }
}
